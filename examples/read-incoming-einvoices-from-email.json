{
  "name": "Read incoming e-invoices from email as JSON (W System)",
  "nodes": [
    {
      "parameters": {
        "downloadAttachments": true,
        "options": {}
      },
      "id": "6f1d6b2e-1a01-4c55-9d1e-0a1e1e000001",
      "name": "New invoice email (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// One item per XML or PDF attachment (XRechnung, ZUGFeRD/Factur-X PDF, UBL, CII).\nconst out = [];\nfor (const item of $input.all()) {\n  for (const bin of Object.values(item.binary || {})) {\n    const name = (bin.fileName || '').toLowerCase();\n    if (!/\\.(xml|pdf)$/.test(name)) continue;\n    out.push({\n      json: { from: item.json.from, subject: item.json.subject, fileName: bin.fileName },\n      binary: { invoice: bin },\n    });\n  }\n}\nreturn out;"
      },
      "id": "6f1d6b2e-1a01-4c55-9d1e-0a1e1e000002",
      "name": "One item per XML/PDF attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.wsystem.dev/einvoice/parse?ref=n8n-template",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "" }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "invoice",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "6f1d6b2e-1a01-4c55-9d1e-0a1e1e000003",
      "name": "Parse e-invoice (W System)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "notes": "Works without a key on the shared free tier. Paste a free key from https://api.wsystem.dev/docs?ref=n8n-template into X-API-Key for a bigger monthly allowance."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.invoice?.invoice_number }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6f1d6b2e-1a01-4c55-9d1e-0a1e1e000004",
      "name": "Is an e-invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "invoice_number", "value": "={{ $json.invoice.invoice_number }}", "type": "string" },
            { "id": "a2", "name": "issue_date", "value": "={{ $json.invoice.issue_date }}", "type": "string" },
            { "id": "a3", "name": "seller", "value": "={{ $json.invoice.seller.name }}", "type": "string" },
            { "id": "a4", "name": "seller_vat_id", "value": "={{ $json.invoice.seller.vat_id }}", "type": "string" },
            { "id": "a5", "name": "currency", "value": "={{ $json.invoice.currency }}", "type": "string" },
            { "id": "a6", "name": "total_with_vat", "value": "={{ $json.invoice.totals.total_with_vat }}", "type": "string" },
            { "id": "a7", "name": "amount_due", "value": "={{ $json.invoice.totals.amount_due }}", "type": "string" },
            { "id": "a8", "name": "iban", "value": "={{ ($json.invoice.payment || [])[0]?.iban }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "6f1d6b2e-1a01-4c55-9d1e-0a1e1e000005",
      "name": "Invoice row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, -100],
      "notes": "Send this row on to Google Sheets, your accounting tool or a database."
    }
  ],
  "connections": {
    "New invoice email (IMAP)": { "main": [[{ "node": "One item per XML/PDF attachment", "type": "main", "index": 0 }]] },
    "One item per XML/PDF attachment": { "main": [[{ "node": "Parse e-invoice (W System)", "type": "main", "index": 0 }]] },
    "Parse e-invoice (W System)": { "main": [[{ "node": "Is an e-invoice?", "type": "main", "index": 0 }]] },
    "Is an e-invoice?": { "main": [[{ "node": "Invoice row", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
