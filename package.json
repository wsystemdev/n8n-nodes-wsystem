{
	"name": "n8n-nodes-wsystem",
	"version": "0.1.0",
	"description": "n8n node for the W System EU business data API: EU VAT (VIES), EORI, company registry, sanctions screening and KYB",
	"license": "MIT",
	"homepage": "https://github.com/zifengw/n8n-nodes-wsystem",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"vat",
		"vies",
		"eori",
		"kyb",
		"sanctions",
		"eu"
	],
	"author": {
		"name": "W System Hungary Kft.",
		"email": "zifeng@wsystem.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zifengw/n8n-nodes-wsystem.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WSystemApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WSystem/WSystem.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}